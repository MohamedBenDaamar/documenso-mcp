# Public URL of your Documenso instance (the fork with the OAuth server). It is also the OAuth issuer,
# so it must be exactly Documenso's NEXT_PUBLIC_WEBAPP_URL.
DOCUMENSO_URL=http://localhost:3000
DOCUMENSO_TIMEOUT_MS=10000

# Public origin of this MCP server. `mcp-use dev` sets it automatically; set it explicitly when deployed.
# Documenso must list "<MCP_URL>/mcp" in NEXT_PRIVATE_OAUTH_RESOURCES.
MCP_URL=
