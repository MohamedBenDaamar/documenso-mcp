DOCUMENSO_URL=http://localhost:3000
DOCUMENSO_TIMEOUT_MS=10000

# Public origin of this MCP server. `mcp-use dev` sets it automatically; set it explicitly when deployed.
MCP_URL=

# Supabase project used as the OAuth authorization server. Set SUPABASE_URL or SUPABASE_PROJECT_ID.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 32 random bytes, base64. Encrypts stored Documenso tokens. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=
